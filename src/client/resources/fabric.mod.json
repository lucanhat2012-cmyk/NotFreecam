{
  "schemaVersion": 1,
  "id": "notfreecam",
  "version": "${version}",
  "name": "NotFreecam",
  "description": "A configurable client-side detached camera for Minecraft 26.3.",
  "authors": ["NotFreecam"],
  "license": "MIT",
  "icon": "assets/notfreecam/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.notfreecam.NotFreecamClient"],
    "modmenu": ["dev.notfreecam.NotFreecamModMenu"]
  },
  "custom": {
    "modmenu": {
      "summary": "Detach your camera and explore freely.",
      "links": {
        "modmenu.github": "https://github.com/lucanhat2012-cmyk/NotFreecam"
      },
      "update_checker": false
    }
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
